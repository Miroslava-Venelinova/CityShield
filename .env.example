# ============================================================
#  .env.example — for docker-compose.prod.yml (self-hosted)
#  Copy to .env in the repository root and fill in real values.
#  Never commit the real .env.
#
#  Cloud deploys (PLAN.md) don't use this file: values marked
#  [Secret Manager] live in Google Secret Manager there, the
#  rest become plain Cloud Run env vars.
# ============================================================

# PostgreSQL (PostGIS)
POSTGRES_DB=CityShieldDB
POSTGRES_USER=postgres
# [Secret Manager] db-password
POSTGRES_PASSWORD=

# JWT signing key for the API — at least 32 random characters.
# Generate with:  openssl rand -base64 48
# [Secret Manager] jwt-key
JWT_KEY=

# Shared secret between the ingestion service and the API's
# /api/alerts/submit-data endpoint.
# Generate with:  openssl rand -hex 32
# [Secret Manager] ingest-api-key
INGEST_API_KEY=

# --- AI parsing ---------------------------------------------
# "ollama" = local LLM (fully self-hosted; keep COMPOSE_PROFILES=ollama)
# "gemini" = hosted Gemini API (set GEMINI_API_KEY, clear COMPOSE_PROFILES)
AI_PROVIDER=ollama
COMPOSE_PROFILES=ollama
OLLAMA_MODEL=qwen3.5
# [Secret Manager] gemini-api-key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
