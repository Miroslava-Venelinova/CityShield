# ── Secrets — never commit ────────────────────────────────
.env
# Firebase service-account key. Push now goes through OneSignal, so this is no
# longer a Worker secret — but the file still exists under backend_deprecated/
# and is still a live credential.
fcm.json

# ── Cloudflare Worker backend (backend/) ──────────────────
# Build/dev artefacts (node_modules, dist, .wrangler, .dev.vars, seed.sql) are
# ignored by backend/.gitignore; spike caches by backend/spikes/.gitignore.

# ── Editors ───────────────────────────────────────────────
.vscode/

# ── React Native app (frontend/) ──────────────────────────
frontend/node_modules/
frontend/android/.gradle/
frontend/android/build/
frontend/android/app/build/
frontend/android/app/.cxx/
frontend/android/local.properties
frontend/android/app/src/main/assets/index.android.bundle
frontend/*.keystore
!frontend/android/app/debug.keystore
frontend/.metro-cache/

# ── Deprecated pre-Cloudflare stack (backend_deprecated/) ─────────
# Python ingestion
*.log
*.pyc
__pycache__/
.venv/
backend_deprecated/backend/cache
backend_deprecated/backend/map.html
backend_deprecated/backend/processing/.ai_parser_cache.json
# .NET API
bin/
obj/
.vs/
*.vsidx
# Docker prod stack
docker-data/
