# ── CityShield environment variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# This file is read automatically by Docker Compose.
#
# API_URL:
#   - Android Emulator (default): http://10.0.2.2:<port>
#     10.0.2.2 is the special address the emulator uses to reach your PC's localhost.
#   - Real Android device on same Wi-Fi: http://192.168.x.x:<port>
#     Find your IP: run `ipconfig` (Windows) or `ifconfig` (Mac/Linux).
#   - Production server: https://your-server.com
#
API_URL=http://10.0.2.2:5276
