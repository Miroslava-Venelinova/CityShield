<?xml version="1.0" encoding="utf-8"?>
<!--
  Release network security config: no cleartext traffic anywhere.
  The debug build variant overrides this file (src/debug/res/xml/…) to allow
  plain HTTP to the local dev API at 10.0.2.2.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false" />
  <!-- OpenStreetMap tile servers (HTTPS only) -->
  <domain-config cleartextTrafficPermitted="false">
    <domain includeSubdomains="true">openstreetmap.org</domain>
    <domain includeSubdomains="true">tile.openstreetmap.org</domain>
  </domain-config>
</network-security-config>
