# ============================================================
#  backend/.env
#  DO NOT commit this file to version control.
#  Add .env to your .gitignore.
# ============================================================

# --- MongoDB ------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=cityshield

# --- PostgreSQL (PostGIS — polygon resolution) --------------
POSTGRES_DB=mydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- ASP.NET API --------------------------------------------
# swap verify=False for a real cert bundle before going to production
ASP_API_URL=https://localhost:7180/api/VK/submit-data

# --- Ollama (local LLM) -------------------------------------
OLLAMA_MODEL=qwen3.5

# --- Nominatim (self-hosted OSM geocoder) -------------------
NOMINATIM_HOST=localhost:8080
NOMINATIM_SCHEME=http
NOMINATIM_USER_AGENT=city_shield

# --- Overpass (OSM query API) -------------------------------
OVERPASS_URL=https://overpass.kumi.systems/api/interpreter

# --- Scraping source URLs -----------------------------------
VIK_URL=https://vikvarna.com/bg/messages.html?region_id=15&sub_region_id=&type=breakdown
VT_URL=https://www.varnatraffic.com/Info

# --- Polling intervals (seconds) ----------------------------
# Leave a service interval blank to use DEFAULT_INTERVAL.
DEFAULT_INTERVAL=600
VIK_INTERVAL=
VT_INTERVAL=
EPRO_INTERVAL=
