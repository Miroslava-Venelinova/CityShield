# ============================================================
#  backend/.env.example
#  Copy to backend/.env and adjust. Never commit the real .env.
# ============================================================

# --- PostgreSQL (crawl state, street/region fuzzy matching, PostGIS)
POSTGRES_DB=CityShieldDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# libpq sslmode. "prefer" for local docker-compose; "require" for managed
# providers that enforce TLS (e.g. Neon).
POSTGRES_SSLMODE=prefer

# --- ASP.NET API ---------------------------------------------
ASP_API_URL=http://localhost:5276/api/alerts/submit-data
# Shared secret for the ingest endpoint; must match the API's
# Ingest__ApiKey environment variable. Leave empty for local dev.
ASP_API_KEY=
# Set to false only when the API uses a self-signed certificate.
ASP_API_VERIFY_SSL=true

# --- AI parsing ----------------------------------------------
# "ollama" = local LLM (offline dev / self-hosted)
# "gemini" = hosted Gemini API (cloud deployment)
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5
# Gemini API key (aistudio.google.com). Secret — in cloud deploys this comes
# from Secret Manager, never from a committed file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Polling intervals (seconds; blank = DEFAULT 600) --------
#VIK_INTERVAL=
#VT_INTERVAL=
#EPRO_INTERVAL=
#HEATING_INTERVAL=
#ROADS_INTERVAL=

# --- Logging -------------------------------------------------
# CRITICAL / ERROR / WARNING / INFO / DEBUG
LOG_LEVEL=INFO
# Also write backend.log next to stdout. Set false in cloud runs
# (tmpfs filesystem; stdout is captured by the platform).
LOG_TO_FILE=true

# --- Debugging (keep off in production) ----------------------
# Cache LLM responses on disk so repeated runs skip the model.
AI_PERSISTENT_CACHE=false
# Write a Folium debug map (map.html) for every polygon built.
# Requires the dev dependencies (pip install -r requirements-dev.txt).
POLYGON_DEBUG_MAP=false
