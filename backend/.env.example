# ============================================================
#  backend/.env.example
#  Copy to backend/.env and adjust. Never commit the real .env.
# ============================================================

# --- MongoDB (crawl state) -----------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=cityshield

# --- PostgreSQL (street/region fuzzy matching, PostGIS) ------
POSTGRES_DB=CityShieldDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- ASP.NET API ---------------------------------------------
ASP_API_URL=http://localhost:5276/api/alerts/submit-data
# Shared secret for the ingest endpoint; must match the API's
# Ingest__ApiKey environment variable. Leave empty for local dev.
ASP_API_KEY=
# Set to false only when the API uses a self-signed certificate.
ASP_API_VERIFY_SSL=true

# --- Ollama (local LLM parsing) ------------------------------
OLLAMA_MODEL=qwen3.5

# --- Polling intervals (seconds; blank = DEFAULT 600) --------
#VIK_INTERVAL=
#VT_INTERVAL=
#EPRO_INTERVAL=
#HEATING_INTERVAL=
#ROADS_INTERVAL=

# --- Debugging (keep off in production) ----------------------
# Cache LLM responses on disk so repeated runs skip the model.
AI_PERSISTENT_CACHE=false
# Write a Folium debug map (map.html) for every polygon built.
POLYGON_DEBUG_MAP=false
