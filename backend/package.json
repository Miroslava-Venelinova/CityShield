{
  "name": "cityshield-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:generate": "node seeds/generate-seed.mjs",
    "db:local": "node seeds/apply.mjs --local",
