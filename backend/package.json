    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "@cloudflare/workers-types": "^4.20260701.0",
    "cheerio": "^1.2.0",
    "typescript": "^5.5.0",
    "vitest": "~3.2.0",
    "wrangler": "~4.36.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.4": true,
    "sharp@0.33.5": true,
    "workerd@1.20250906.0": true
  }
